---
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PsiqExpert — Mentoria Premium em Psiquiatria</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Lato:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet" />
  <style>
    /* ── TOKENS ───────────────────────────────────── */
    :root {
      --navy:        #0a1422;
      --navy-mid:    #0f1d30;
      --gold:        #c9a046;
      --gold-bright: #ddb85a;
      --gold-dim:    rgba(201,160,70,0.5);
      --cream:       #f7f3ec;
      --text-body:   #3a2e1e;
      --white:       #ffffff;
      --shadow-card: 0 12px 56px rgba(0,0,0,0.45), 0 2px 12px rgba(0,0,0,0.2);
      --shadow-gold: 0 4px 24px rgba(201,160,70,0.28);
      --shadow-gold-h: 0 8px 40px rgba(201,160,70,0.48);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Lato', sans-serif;
      background: var(--navy);
      color: var(--white);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ── ATTENTION BAR ────────────────────────────── */
    .attn {
      position: relative; overflow: hidden;
      background: var(--gold);
      padding: 9px 20px;
      text-align: center;
      font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--navy);
    }
    .attn::after {
      content: '';
      position: absolute; top: 0; left: -80%;
      width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.38), transparent);
      animation: shimmer 3.5s infinite ease-in-out;
    }
    @keyframes shimmer { to { left: 160%; } }

    /* ── HERO ─────────────────────────────────────── */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex; flex-direction: column; justify-content: center;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background-image: url('bg.jpg');
      background-size: cover;
      background-position: center;
      z-index: 0;
    }
    .hero-bg::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(
        110deg,
        rgba(10,20,34,0.95) 0%,
        rgba(10,20,34,0.82) 45%,
        rgba(10,20,34,0.60) 75%,
        rgba(10,20,34,0.40) 100%
      );
    }

    .hero-inner {
      position: relative;
      max-width: 1200px; margin: 0 auto;
      padding: 72px 32px 88px;
      width: 100%;
    }

    /* ── BRAND MARK ───────────────────────────────── */
    .brand-mark {
      display: flex;
      align-items: center;
      margin-bottom: 36px;
    }
    .brand-logo {
      height: 170px;
      width: auto;
      display: block;
      flex-shrink: 0;
      -webkit-mask-image: radial-gradient(
        ellipse 55% 82% at 42% 45%,
        black 30%,
        rgba(0,0,0,0.7) 52%,
        rgba(0,0,0,0.15) 70%,
        transparent 86%
      );
      mask-image: radial-gradient(
        ellipse 55% 82% at 42% 45%,
        black 30%,
        rgba(0,0,0,0.7) 52%,
        rgba(0,0,0,0.15) 70%,
        transparent 86%
      );
      filter: brightness(1.08) drop-shadow(0 4px 24px rgba(201,160,70,0.3));
      transition: filter 0.4s;
    }
    .brand-logo:hover {
      filter: brightness(1.15) drop-shadow(0 6px 32px rgba(201,160,70,0.45));
    }
    /* ── HERO BODY ────────────────────────────────── */
    .hero-body {
      display: grid;
      grid-template-columns: 1fr;
      gap: 48px;
      align-items: center;
    }

    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 12px;
      font-size: 0.62rem; font-weight: 700; letter-spacing: 0.28em;
      text-transform: uppercase; color: var(--gold);
      margin-bottom: 18px;
    }
    .hero-eyebrow::before, .hero-eyebrow::after {
      content: ''; width: 22px; height: 1px;
      background: var(--gold); opacity: 0.45;
    }

    .hero-h1 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      font-size: clamp(2.4rem, 5.5vw, 4.4rem);
      line-height: 1.06;
      color: var(--white);
      margin-bottom: 22px;
      letter-spacing: -0.01em;
    }
    .hero-h1 em {
      color: var(--gold-bright);
      font-style: italic;
      display: block;
    }
    .hero-tagline {
      display: inline-block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(201,160,70,0.7);
      border-top: 1px solid rgba(201,160,70,0.25);
      padding-top: 14px;
      margin-top: 4px;
      margin-bottom: 24px;
    }
    .hero-sub {
      font-size: clamp(0.9rem, 1.7vw, 1.02rem);
      font-weight: 300;
      line-height: 1.85;
      color: rgba(255,255,255,0.62);
      max-width: 520px;
    }

    /* ── FORM ─────────────────────────────────────── */
    .form-wrap {
      position: relative;
      width: 100%; max-width: 486px; margin: 0 auto;
    }
    /* Halo de luz atrás do cartão — ilumina a área do formulário */
    .form-wrap::before {
      content: '';
      position: absolute; inset: -16% -13%;
      background: radial-gradient(ellipse at center,
        rgba(201,160,70,0.20) 0%,
        rgba(201,160,70,0.09) 40%,
        transparent 70%);
      filter: blur(10px);
      pointer-events: none; z-index: 0;
    }

    /* Moldura externa com cantoneiras — referência ao brasão */
    .form-frame {
      position: relative; z-index: 1;
      padding: 11px;
    }
    .form-frame::before {
      content: '';
      position: absolute; inset: 0;
      border: 1px solid rgba(201,160,70,0.3);
      border-radius: 4px;
      pointer-events: none;
    }
    .form-frame::after {
      content: '';
      position: absolute; inset: 0;
      pointer-events: none;
      background:
        linear-gradient(var(--gold-bright),var(--gold-bright)) left  top   /22px 2px no-repeat,
        linear-gradient(var(--gold-bright),var(--gold-bright)) left  top   /2px 22px no-repeat,
        linear-gradient(var(--gold-bright),var(--gold-bright)) right top   /22px 2px no-repeat,
        linear-gradient(var(--gold-bright),var(--gold-bright)) right top   /2px 22px no-repeat,
        linear-gradient(var(--gold-bright),var(--gold-bright)) left  bottom/22px 2px no-repeat,
        linear-gradient(var(--gold-bright),var(--gold-bright)) left  bottom/2px 22px no-repeat,
        linear-gradient(var(--gold-bright),var(--gold-bright)) right bottom/22px 2px no-repeat,
        linear-gradient(var(--gold-bright),var(--gold-bright)) right bottom/2px 22px no-repeat;
    }

    .form-card {
      position: relative;
      background: linear-gradient(165deg, rgba(18,33,55,0.97) 0%, rgba(9,18,32,0.98) 100%);
      backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(201,160,70,0.5);
      border-radius: 3px;
      padding: 0 32px 34px;
      overflow: hidden;
      animation: formGlow 7s ease-in-out infinite;
    }
    /* Respiro lento do halo — chama o olhar sem piscar */
    @keyframes formGlow {
      0%, 100% {
        box-shadow: 0 0 44px rgba(201,160,70,0.18),
                    0 18px 64px rgba(0,0,0,0.6),
                    inset 0 1px 0 rgba(255,255,255,0.06);
      }
      50% {
        box-shadow: 0 0 86px rgba(201,160,70,0.36),
                    0 18px 64px rgba(0,0,0,0.6),
                    inset 0 1px 0 rgba(255,255,255,0.06);
      }
    }

    /* Faixa dourada sólida — âncora visual do cartão */
    .form-band {
      position: relative; overflow: hidden;
      margin: 0 -32px 24px;
      padding: 12px 16px;
      background: linear-gradient(90deg, #a87328 0%, var(--gold-bright) 40%, var(--gold) 68%, #a87328 100%);
      color: var(--navy); text-align: center;
      font-size: 0.63rem; font-weight: 700;
      letter-spacing: 0.26em; text-transform: uppercase;
      box-shadow: 0 2px 18px rgba(201,160,70,0.3);
    }
    .form-band::after {
      content: '';
      position: absolute; top: 0; left: -80%;
      width: 45%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
      animation: shimmer 5s infinite ease-in-out;
      pointer-events: none;
    }

    .form-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.85rem; font-weight: 600;
      color: var(--gold-bright);
      text-align: center; margin-bottom: 6px;
      line-height: 1.15;
    }
    .form-sub {
      font-size: 0.63rem; color: rgba(255,255,255,0.42);
      text-align: center; letter-spacing: 0.14em; text-transform: uppercase;
      margin-bottom: 26px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(201,160,70,0.14);
    }
    .form-row { margin-bottom: 13px; }
    .form-row label {
      display: block; font-size: 0.61rem; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: rgba(201,160,70,0.65); margin-bottom: 6px;
    }
    .form-row input {
      width: 100%;
      background: rgba(255,255,255,0.055);
      border: 1px solid rgba(201,160,70,0.24);
      border-radius: 2px; padding: 12px 14px;
      font-family: 'Lato', sans-serif; font-size: 0.9rem;
      color: var(--white); outline: none;
      transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
    }
    .form-row input::placeholder { color: rgba(255,255,255,0.22); }
    .form-row input:focus {
      border-color: var(--gold);
      background: rgba(201,160,70,0.07);
      box-shadow: 0 0 0 3px rgba(201,160,70,0.13);
    }

    .btn-submit {
      position: relative; overflow: hidden;
      display: block; width: 100%;
      background: linear-gradient(90deg, #a87328 0%, var(--gold-bright) 38%, var(--gold) 65%, #a87328 100%);
      background-size: 220% 100%;
      color: var(--navy); border: none;
      padding: 17px 24px; margin-top: 24px;
      font-family: 'Lato', sans-serif; font-size: 0.76rem; font-weight: 700;
      letter-spacing: 0.2em; text-transform: uppercase;
      cursor: pointer; border-radius: 2px;
      box-shadow: 0 6px 30px rgba(201,160,70,0.42);
      transition: background-position 0.55s, transform 0.15s, box-shadow 0.3s;
    }
    /* Brilho contínuo — atrai o olhar para a ação sem piscar */
    .btn-submit::after {
      content: '';
      position: absolute; top: 0; left: -80%;
      width: 45%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.45), transparent);
      animation: shimmer 4.2s infinite ease-in-out;
      pointer-events: none;
    }
    .btn-submit:hover {
      background-position: 100% 0;
      transform: translateY(-2px);
      box-shadow: 0 10px 44px rgba(201,160,70,0.6);
    }
    .btn-submit:active { transform: none; }
    .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .btn-submit:disabled::after { display: none; }
    .form-legal {
      font-size: 0.61rem; color: rgba(255,255,255,0.25);
      text-align: center; margin-top: 14px; line-height: 1.65; letter-spacing: 0.04em;
    }
    .form-success { display: none; text-align: center; padding: 12px 0; }
    .form-success.on { display: block; }
    .success-circle {
      width: 56px; height: 56px; border-radius: 50%;
      border: 1.5px solid var(--gold); background: rgba(201,160,70,0.08);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem; color: var(--gold-bright); margin: 0 auto 16px;
    }
    .form-success h3 {
      font-family: 'Cormorant Garamond', serif; font-size: 1.5rem;
      color: var(--gold-bright); margin-bottom: 8px;
    }
    .form-success p { font-size: 0.875rem; color: rgba(255,255,255,0.5); line-height: 1.7; }

    /* ── PILARES (dark section) ───────────────────── */
    .pilares {
      background: linear-gradient(160deg, #080f1c 0%, var(--navy-mid) 60%, #0c1828 100%);
      padding: 88px 28px;
      position: relative; overflow: hidden;
    }
    .pilares::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--gold) 50%, transparent);
    }
    .pilares::after {
      content: ''; position: absolute;
      top: -120px; right: -120px;
      width: 500px; height: 500px; border-radius: 50%;
      background: radial-gradient(circle, rgba(201,160,70,0.04) 0%, transparent 70%);
      pointer-events: none;
    }

    .section-inner {
      max-width: 1100px; margin: 0 auto;
      position: relative; z-index: 1;
    }

    .section-header { text-align: center; margin-bottom: 56px; }
    .section-kicker {
      display: inline-flex; align-items: center; gap: 12px;
      font-size: 0.62rem; font-weight: 700; letter-spacing: 0.26em;
      text-transform: uppercase; color: var(--gold); margin-bottom: 16px;
    }
    .section-kicker::before, .section-kicker::after {
      content: ''; width: 28px; height: 1px;
      background: var(--gold); opacity: 0.45;
    }
    .section-h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 600;
      line-height: 1.2; color: var(--white);
    }
    .section-sub {
      font-size: clamp(0.9rem, 1.6vw, 1rem);
      color: rgba(255,255,255,0.48);
      line-height: 1.8; margin-top: 14px;
      max-width: 580px; margin-left: auto; margin-right: auto;
    }

    .pilares-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .pilar-card {
      background: rgba(255,255,255,0.025);
      border: 1px solid rgba(201,160,70,0.13);
      border-radius: 3px;
      padding: 32px 28px;
      position: relative; overflow: hidden;
      transition: border-color 0.3s, background 0.3s, transform 0.25s;
    }
    .pilar-card::before {
      content: '';
      position: absolute; top: 0; left: 0;
      width: 3px; height: 100%;
      background: linear-gradient(180deg, var(--gold), transparent);
      opacity: 0.5;
    }
    .pilar-card:hover {
      border-color: rgba(201,160,70,0.32);
      background: rgba(201,160,70,0.035);
      transform: translateX(4px);
    }
    .pilar-num {
      display: inline-flex; align-items: center; justify-content: center;
      width: 52px; height: 52px; border-radius: 50%;
      background: linear-gradient(140deg, rgba(201,160,70,0.22), rgba(201,160,70,0.06));
      border: 1px solid rgba(201,160,70,0.55);
      font-family: 'Lato', sans-serif;
      font-size: 1.05rem; font-weight: 700;
      letter-spacing: 0.06em;
      font-variant-numeric: lining-nums;
      color: var(--gold-bright);
      line-height: 1; margin-bottom: 18px;
      box-shadow: 0 2px 16px rgba(201,160,70,0.18), inset 0 1px 0 rgba(255,255,255,0.08);
      transition: background 0.3s, box-shadow 0.3s;
    }
    .pilar-card:hover .pilar-num {
      background: linear-gradient(140deg, rgba(201,160,70,0.34), rgba(201,160,70,0.1));
      box-shadow: 0 4px 24px rgba(201,160,70,0.32), inset 0 1px 0 rgba(255,255,255,0.12);
    }
    .pilar-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.35rem; font-weight: 600;
      color: var(--gold-bright); margin-bottom: 10px;
    }
    .pilar-text {
      font-size: 0.9rem; color: rgba(255,255,255,0.55);
      line-height: 1.82;
    }
    .pilar-items {
      list-style: none; margin-top: 14px;
    }
    .pilar-items li {
      display: flex; align-items: flex-start; gap: 10px;
      font-size: 0.875rem; color: rgba(255,255,255,0.5);
      padding: 5px 0;
      border-bottom: 1px solid rgba(201,160,70,0.07);
    }
    .pilar-items li:last-child { border-bottom: none; }
    .pilar-items li::before { content: '◆'; color: var(--gold); font-size: 0.45rem; flex-shrink: 0; margin-top: 5px; }

    /* ── CARTA ────────────────────────────────────── */
    .carta {
      background: var(--cream);
      color: #1a1208;
      position: relative;
    }
    .carta::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--gold) 50%, transparent);
    }
    .carta-wrap {
      max-width: 780px; margin: 0 auto;
      padding: 80px 28px 88px;
    }
    .carta-header {
      text-align: center; margin-bottom: 52px;
      padding-bottom: 38px;
      border-bottom: 1px solid rgba(201,160,70,0.22);
    }
    .carta-kicker {
      font-size: 0.62rem; font-weight: 700;
      letter-spacing: 0.26em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 16px;
      display: flex; align-items: center; justify-content: center; gap: 12px;
    }
    .carta-kicker::before, .carta-kicker::after {
      content: ''; width: 28px; height: 1px;
      background: var(--gold); opacity: 0.45; display: block;
    }
    .carta-h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 600;
      line-height: 1.2; color: var(--navy);
    }
    .carta-body {
      font-size: clamp(0.95rem, 1.7vw, 1.04rem);
      line-height: 1.92; color: var(--text-body);
    }
    .carta-body p { margin-bottom: 24px; }
    .carta-body strong { color: var(--navy); font-weight: 700; }

    .sit-list {
      list-style: none; margin: 30px 0;
      border-left: 2px solid var(--gold);
      border-radius: 0 3px 3px 0;
      background: white; overflow: hidden;
      box-shadow: 0 2px 20px rgba(0,0,0,0.06);
    }
    .sit-list li {
      padding: 13px 24px;
      border-bottom: 1px solid rgba(201,160,70,0.1);
      font-style: italic; color: var(--text-body);
      display: flex; align-items: flex-start; gap: 14px;
      font-size: 0.97rem; line-height: 1.6;
    }
    .sit-list li:last-child { border-bottom: none; }
    .sit-list li::before {
      content: '—'; color: var(--gold);
      font-style: normal; font-weight: 700; flex-shrink: 0;
    }

    .s-heading {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 600;
      color: var(--navy); margin: 52px 0 22px;
      padding-bottom: 14px; position: relative;
    }
    .s-heading::after {
      content: ''; position: absolute; bottom: 0; left: 0;
      width: 36px; height: 2px; background: var(--gold);
    }

    .t-list { list-style: none; margin: 18px 0; }
    .t-list li {
      display: flex; align-items: flex-start; gap: 11px;
      padding: 8px 0; font-size: 0.95rem; color: var(--text-body);
      border-bottom: 1px solid rgba(201,160,70,0.1);
    }
    .t-list li:last-child { border-bottom: none; }
    .t-list li::before { content: '✔'; color: var(--gold); flex-shrink: 0; }

    /* ── FORMATOS (6 ou 12 meses) ─────────────────── */
    .formatos {
      display: grid; grid-template-columns: 1fr;
      gap: 18px; margin: 32px 0 30px;
    }
    .formato-card {
      position: relative;
      background: white; border-radius: 3px;
      border-top: 2px solid rgba(201,160,70,0.45);
      padding: 28px 26px 24px;
      box-shadow: 0 2px 20px rgba(0,0,0,0.06);
    }
    .formato-card.destaque {
      border-top-color: var(--gold);
      box-shadow: 0 4px 28px rgba(201,160,70,0.16), 0 2px 20px rgba(0,0,0,0.06);
    }
    .formato-selo {
      position: absolute; top: -1px; right: 20px;
      background: var(--gold); color: var(--navy);
      font-size: 0.56rem; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase;
      padding: 4px 11px 3px; border-radius: 0 0 2px 2px;
    }
    .formato-prazo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.1rem; font-weight: 600;
      color: var(--navy); line-height: 1;
      font-variant-numeric: lining-nums;
    }
    .formato-nome {
      font-size: 0.6rem; font-weight: 700;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--gold); margin: 7px 0 14px;
    }
    .formato-desc {
      font-size: 0.9rem; line-height: 1.75;
      color: var(--text-body); margin: 0 0 14px !important;
    }
    .formato-lista { list-style: none; }
    .formato-lista li {
      display: flex; align-items: flex-start; gap: 10px;
      font-size: 0.85rem; color: var(--text-body);
      padding: 6px 0; line-height: 1.6;
      border-bottom: 1px solid rgba(201,160,70,0.1);
    }
    .formato-lista li:last-child { border-bottom: none; }
    .formato-lista li::before {
      content: '◆'; color: var(--gold);
      font-size: 0.42rem; flex-shrink: 0; margin-top: 7px;
    }

    .footnote {
      font-size: 0.74rem; font-style: italic;
      color: rgba(58,46,30,0.55);
      letter-spacing: 0.03em;
      margin-top: -6px !important;
    }

    .diff-box {
      background: white; border-radius: 3px;
      border-top: 2px solid var(--gold);
      padding: 30px 28px; margin: 30px 0;

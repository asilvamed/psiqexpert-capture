  <script>
    /* ── Scroll reveal ─────────────────────────────── */
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    document.querySelectorAll('.hero .reveal').forEach((el, i) => {
      setTimeout(() => el.classList.add('in'), i * 200);
    });

    /* ── WhatsApp mask ─────────────────────────────── */
    const wa = document.getElementById('whatsapp');
    wa.addEventListener('input', () => {
      let v = wa.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 6) v = `(${v.slice(0,2)}) ${v.slice(2,7)}-${v.slice(7)}`;
      else if (v.length > 2) v = `(${v.slice(0,2)}) ${v.slice(2)}`;
      else if (v.length > 0) v = `(${v}`;
      wa.value = v;
    });

    /* ── Form submit ───────────────────────────────── */
    const form = document.getElementById('capture-form');
    const btnEl = document.getElementById('submit-btn');
    const wrapEl = document.getElementById('form-wrap');
    const successEl = document.getElementById('form-success');

    form.addEventListener('submit', async e => {
      e.preventDefault();
      btnEl.textContent = 'Enviando…'; btnEl.disabled = true;
      const params = new URLSearchParams();
      new FormData(form).forEach((v, k) => params.append(k, v));
      try { await fetch('https://script.google.com/macros/s/AKfycbydyDnyeqfMRhwxwfeXxvNgiFFUhAInNByymICNG2TbDPq1F_dS4r8cgKyyq_aWj59p0A/exec', { method: 'POST', body: params, mode: 'no-cors' }); } catch (_) {}
      wrapEl.style.display = 'none'; successEl.classList.add('on');
    });
  </script>

